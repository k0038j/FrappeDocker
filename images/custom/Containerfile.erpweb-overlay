ARG BASE_IMAGE=cise/erpnext-hrms:f16.29.0-e16.30.0-h16.17.1-via0.5.15

FROM node:20-bookworm-slim AS hrms-frontend-builder
WORKDIR /build/frontend
COPY --from=hrms /frontend/package.json /frontend/yarn.lock ./
RUN corepack enable && corepack prepare yarn@1.22.22 --activate && yarn install --frozen-lockfile
COPY --from=hrms /frontend/ ./
RUN mkdir -p /build/hrms/public/frontend /build/hrms/www && yarn build

FROM ${BASE_IMAGE} AS frappe-assets-builder

COPY --chown=frappe:frappe images/custom/framework_overlays/frappe/frappe/public/js/frappe/ui/toolbar/bilingual_fuzzy_search.js /home/frappe/frappe-bench/apps/frappe/frappe/public/js/frappe/ui/toolbar/bilingual_fuzzy_search.js
COPY --chown=frappe:frappe images/custom/framework_overlays/frappe/patches/awesome-bar-bilingual.patch /tmp/awesome-bar-bilingual.patch

RUN set -eux; \
  cd /home/frappe/frappe-bench/apps/frappe; \
  git apply --check /tmp/awesome-bar-bilingual.patch; \
  git apply /tmp/awesome-bar-bilingual.patch; \
  cd /home/frappe/frappe-bench; \
  mkdir -p sites/assets; \
  cp -a assets/. sites/assets/; \
  bench build --app frappe

